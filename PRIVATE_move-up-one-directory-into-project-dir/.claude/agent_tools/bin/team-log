#!/usr/bin/env bash
# team-log — stitch per-agent session logs into all-teams-session-log.md
# VERSION: 1.0.0
#
# Each agent prepends entries ONLY to their own file in
# agent_docs/untracked/session-logs/<agent-slug>.md — zero write contention,
# no merge conflicts if the logs ever move into git. This script generates
# the combined newest-first view every agent reads.
#
# Usage:
#   team-log            regenerate all-teams-session-log.md
#   team-log --check    exit 1 if the combined view is stale (older than any
#                       per-agent log), 0 otherwise; prints nothing on fresh
#
# Entry format (same as before, one block per session, in your OWN file):
#   ## YYYY-MM-DD HH:MM UTC — Agent Name emoji (team)
#   - what happened, ultra-concise
#   - NEXT: what's next
#
# Blocks are sorted newest-first across all agents by the timestamp in the
# `## ` header. Blocks with no parseable timestamp sort to the bottom.
# Files named EXAMPLE-*.md are skipped.
#
# Override paths via env: TEAM_LOG_DIR (untracked dir), TEAM_LOG_OUT (output).

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
UNTRACKED="${TEAM_LOG_DIR:-$SCRIPT_DIR/../../agent_docs/untracked}"
UNTRACKED="$(cd "$UNTRACKED" && pwd)" || { echo "ERROR: untracked dir not found: $UNTRACKED" >&2; exit 1; }
SRC="$UNTRACKED/session-logs"
OUT="${TEAM_LOG_OUT:-$UNTRACKED/all-teams-session-log.md}"

[[ -d "$SRC" ]] || { echo "ERROR: no session-logs dir at $SRC — create it and add <agent-slug>.md files" >&2; exit 1; }

shopt -s nullglob
sources=()
for f in "$SRC"/*.md; do
  [[ "$(basename "$f")" == EXAMPLE-* ]] && continue
  sources+=("$f")
done

if [[ "${1:-}" == "--check" ]]; then
  [[ -f "$OUT" ]] || { echo "stale: $OUT missing" >&2; exit 1; }
  for f in "${sources[@]}"; do
    if [[ "$f" -nt "$OUT" ]]; then echo "stale: $f newer than $OUT" >&2; exit 1; fi
  done
  exit 0
fi

tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT

# Split each agent file into one temp file per `## ` block, named so a
# reverse string sort yields newest-first (timestamp sanitized into the name).
idx=0
for f in "${sources[@]}"; do
  idx=$((idx + 1))
  awk -v tmpdir="$tmp" -v fileidx="$idx" '
    /^## / {
      ts = "0000-00-00-00-00"
      if (match($0, /[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9] [0-9][0-9]:[0-9][0-9]/)) {
        ts = substr($0, RSTART, RLENGTH)
        gsub(/[ :]/, "-", ts)
      }
      n++
      out = sprintf("%s/%s.%02d-%04d", tmpdir, ts, fileidx, n)
    }
    out { print >> out }
  ' "$f"
done

{
  echo "# All-Teams Session Log"
  echo
  echo "> GENERATED by \`agent_tools/bin/team-log\` — do NOT edit this file."
  echo "> Write your entries to \`session-logs/<your-agent-slug>.md\` (your OWN"
  echo "> file only), then rerun \`team-log\`. Newest entries at top, all agents"
  echo "> interleaved."
  echo
  echo "---"
  blocks=("$tmp"/*)
  if [[ -e "${blocks[0]:-}" ]]; then
    for b in $(ls "$tmp" | sort -r); do
      echo
      cat "$tmp/$b"
    done
  fi
} > "$OUT.tmp"
mv "$OUT.tmp" "$OUT"

echo "✓ stitched ${#sources[@]} agent log(s) → $OUT"
