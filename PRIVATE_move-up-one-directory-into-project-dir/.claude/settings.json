{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "SPEAK_URL": "[ OPTIONAL TTS ENDPOINT URL — remove if your teams do not speak ]"
  },
  "permissions": {
    "allow": [
      "WebFetch(domain:github.com)",
      "WebFetch(domain:[ DOCS DOMAIN YOUR TEAMS FETCH OFTEN ])",
      "Edit(//[ /path/to/<projectname>_project/teams-repo ]/**)",
      "Write(//[ /path/to/<projectname>_project/teams-repo ]/**)",
      "Edit(//[ /path/to/<projectname>_project/ops-repo ]/**)",
      "Write(//[ /path/to/<projectname>_project/ops-repo ]/**)"
    ],
    "defaultMode": "bypassPermissions",
    "additionalDirectories": [
      "[ /path/to/<projectname>_project/teams-repo ]",
      "[ /path/to/<projectname>_project/ops-repo ]"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ /path/to/home/.claude/team-detect.sh ] resume",
            "statusMessage": "Detecting team & loading context..."
          },
          {
            "type": "command",
            "command": "[ /path/to/home/.claude/cleanup-orphaned-mcp.sh ]",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Glob|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/graphify-nudge.sh"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {}
}
